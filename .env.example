# Default mode keeps the form on this site and posts to /api/waitlist.
NEXT_PUBLIC_WAITLIST_MODE=api

# Optional: wire the stubbed API route to a real endpoint later.
WAITLIST_API_URL=
WAITLIST_API_KEY=

# MailerLite option A: show a hosted MailerLite embed in place of the native form.
NEXT_PUBLIC_MAILERLITE_EMBED_URL=

# MailerLite option B: submit the native fields to a MailerLite form action.
NEXT_PUBLIC_MAILERLITE_FORM_ACTION=

# Analytics placeholders. Set either or both when ready.
NEXT_PUBLIC_GA_MEASUREMENT_ID=
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://app.posthog.com
